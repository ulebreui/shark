!Stationary isothermal dusty shock (Loren-Aguilar & Bate 2014), compile with SETUP=tests GEOM=0 NY=1 NDUST=1

&GRID_PARAMS
freq_out   = 1000000
CFL        = 0.8
tend       = 100.0
gamma      = 1.4
force_kick = .false.
slope_type = 1
/

&SETUP_PARAMS
test_case = 'dustyshock'
box_l     = 60.0
box_l_y   = 0.1
cs0       = 1.0
x_disc    = 20.0
v_shock   = 2.0
eps_shock = 1.0
K_drag    = 1.0
/

&DUST_PARAMS
drag               = .true.
dust_back_reaction = .true.
/
