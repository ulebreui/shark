! Locally isothermal disk on the spherical (r,theta) grid, compile with SETUP=disk_sph GEOM=3 NDUST=0

&GRID_PARAMS
freq_out   = 1000000
CFL        = 0.5
tend       = 63.0
force_kick = .true.
slope_type = 3
/

&SETUP_PARAMS
r_in   = 1.0
r_out  = 10.0
th_min = 1.4207963267948966
th_max = 1.7207963267948966
HoverR = 0.05
p_dens = -1.5
q_temp = -1.0
/


