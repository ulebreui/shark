!This is a namelist for the SHARK code

&GRID_PARAMS
freq_out=5000
CFL=0.8
tend=500. 
gamma=1.666667d0
force_kick=.true.
slope_type=3
/

&SETUP_PARAMS
box_l       = 2d0
box_l_y     = 2d0
rho_init    = 1.0d0
omega_shear = 1.0d0
hoverr      = 0.1
dust2gas_species=0.012d0
stokes_species=0.1d0
stratified = .true.
/

&DUST_PARAMS
dust_back_reaction = .true.
drag               = .true.
/

&GRAVITY_PARAMS
/

&IONISATION_PARAMS
charging=.false.
/

